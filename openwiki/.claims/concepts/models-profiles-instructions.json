  "claims": [
    {
      "id": "claim_ef765ffe40a34bb6bad1e4c5916b0ee9",
      "statement": "SUPPORTED_MODELS is the curated registry of selectable models with hand-maintained ModelOption records (provider-prefixed id, label, per-model efforts list, default_effort, supports_images, and optionally can_be_default); SUPPORTED_MODEL_IDS is the frozen set every resolution layer checks membership against.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L18-L112",
          "version": "repo-lines-v1:sha256:586dd97c3e0c7110bc16087f862b0f4b5b92cdaab63ac82eec7feebd74892f24:"
        }
      ]
    },
    {
      "id": "claim_8a191ee5184a40fc98f87cb4ebe8d4dd",
      "statement": "The efforts a model accepts are per-model and non-uniform (e.g. Kimi K3 only accepts low/high/max, only some advertise xhigh/max), and model_supports_effort/model_supports_images validate a stored selection against the model's own ModelOption fields.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L186-L197",
          "version": "repo-lines-v1:sha256:93afd3d061c3b6cc5a35b1fd6c0e87a6c9db5d5d825450441da58611333f4ec5:"
        }
