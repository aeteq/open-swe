    {
      "id": "claim_ef765ffe40a34bb6bad1e4c5916b0ee9",
      "statement": "SUPPORTED_MODELS is the curated registry of selectable models with hand-maintained ModelOption records (provider-prefixed id, label, per-model efforts list, default_effort, supports_images, and optionally can_be_default); SUPPORTED_MODEL_IDS is the frozen set every resolution layer checks membership against.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L18-L112",
