    {
      "id": "claim_53f2e53105084a8183ad17e58849328e",
      "statement": "Per-user profiles live in the LangGraph Store ['profiles'] namespace keyed by GitHub login, holding a main model pair, optional subagent pair, repository/branch preferences, PR/CI preferences, model-routing/UI settings, and feature flags; profile-editable settings are deliberately split from the encrypted GitHub OAuth token stored in ['oauth_tokens'] so a profile save and a concurrent login/refresh cannot clobber each other's fields.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/profiles.py#L55-L77",
