    {
      "id": "claim_43b45678971048ed916c1a0846b92f9a",
      "statement": "Workspace settings are a two-tier store: an instance record in ['team_settings'] keyed 'default' (legacy 'team settings' from pre-workspace days) plus optional per-workspace overrides in ['workspace_settings']. Reads overlay non-null stored fields over hardcoded defaults fail-soft so an unreachable store degrades to defaults rather than failing every run.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/workspace_settings.py#L37-L44",
