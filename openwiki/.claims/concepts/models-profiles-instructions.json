  "claims": [
    {
      "id": "claim_ef765ffe40a34bb6bad1e4c5916b0ee9",
      "statement": "agent/dashboard/options.py is the single registry of selectable models: SUPPORTED_MODELS is a hand-maintained list of ModelOption records (provider-prefixed id, label, per-model efforts list, default_effort, supports_images), and SUPPORTED_MODEL_IDS is the frozen set every resolution layer checks membership against.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/options.py#L21-L89",
          "version": "repo-lines-v1:sha256:10da1b110046af6bfae6dd8de00db9f76b9ce1de7034c825d725c0eb201dc21e:"
        }
      ]
    },
    {
      "id": "claim_8a191ee5184a40fc98f87cb4ebe8d4dd",
      "statement": "The efforts a model accepts are per-model and non-uniform (e.g. Kimi K3 only accepts low/high/max, only some advertise xhigh/max), and model_supports_effort/model_supports_images validate a stored selection against the model's own ModelOption fields.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/options.py#L21-L89",
          "version": "repo-lines-v1:sha256:e7d29b660903160146ad096d7ead21fc5391a7502e80da828af2b62447f83494:"
