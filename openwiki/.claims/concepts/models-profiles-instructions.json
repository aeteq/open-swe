    },
    {
      "id": "claim_bb46dfb2fe4042f588e5749237cf0336",
      "statement": "Deprecated model ids are not canonically replaced: DEPRECATED_MODEL_REPLACEMENTS has empty values and canonical_model_pair always returns None. Deprecated ids are excluded from provider_fallback_pair and defer to defaults, while unsupported non-deprecated ids may use same-provider and, where possible, same-Claude-family fallback.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/options.py#L276-L316",
          "version": "repo-lines-v1:sha256:6614c2dde46c0c25a2c23a3da788fbf7bb9f9285750a6f37575bdb533afc5173:"
