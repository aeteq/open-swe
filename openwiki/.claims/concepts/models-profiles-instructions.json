  "claims": [
    {
      "id": "claim_ef765ffe40a34bb6bad1e4c5916b0ee9",
      "statement": "SUPPORTED_MODELS is the curated registry of selectable models: each ModelOption contains a provider-prefixed id, label, per-model efforts list, default_effort, supports_images, and optional can_be_default flag. SUPPORTED_MODEL_IDS is the frozen set for membership checks; NON_DEFAULT_MODEL_IDS is a separate frozen set of ids with can_be_default: False that cannot be saved as workspace or profile defaults.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L21-L102",
          "version": "repo-lines-v1:sha256:996f45f34e40289c1bb2fcdee1907e3213257154a5be5186f1577bb5dc7c51f0:"
        }
      ]
    },
    {
      "id": "claim_8a191ee5184a40fc98f87cb4ebe8d4dd",
      "statement": "Efforts per model are non-uniform (e.g. Kimi K3 only accepts low/high/max, Gemini 3.8 Flash uses minimal through high). model_supports_effort validates a stored selection against the model's own efforts list; model_supports_images validates multimodal capability.",
      "evidence": [
