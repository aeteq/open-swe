  "claims": [
    {
      "id": "claim_ef765ffe40a34bb6bad1e4c5916b0ee9",
      "statement": "agent/dashboard/options.py is the single registry of selectable models: SUPPORTED_MODELS is a hand-maintained list of ModelOption records (provider-prefixed id, label, per-model efforts list, default_effort, supports_images), and SUPPORTED_MODEL_IDS is the frozen set every resolution layer checks membership against.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/options.py#L11-L82",
          "version": "repo-lines-v1:sha256:4169f2a0d406430f975a36aa15f221d5e16ca4ab20813caac38a998d4c5513c4:"
        }
      ]
    },
    {
      "id": "claim_8a191ee5184a40fc98f87cb4ebe8d4dd",
      "statement": "The efforts a model accepts are per-model and non-uniform (e.g. Kimi K3 only accepts low/high/max, some models omit none, only some advertise xhigh/max), and model_supports_effort/model_supports_images validate a stored selection against the model's own ModelOption fields.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/options.py#L21-L80",
          "version": "repo-lines-v1:sha256:f76eb8236a6e98903665e5728ed435336127b09c81435188edfcd47deb29b179:"
        },
        {
