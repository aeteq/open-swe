    {
      "id": "claim_6542ad2cef5747e9b221dffc6d2cf2e0",
      "statement": "For a hosted agent run, plan_agent seeds team main/subagent defaults from workspace settings, applies a profile only when no stored thread model exists, then uses stored thread settings when present; a valid cfg.agent_model_id/agent_effort from explicit per-run override is the mechanism that replaces that snapshot and the resolved settings are persisted back to the thread via store_thread_settings.",
      "evidence": [
        {
          "resource": "repo://openswe/server.py#L1738-L1920",
