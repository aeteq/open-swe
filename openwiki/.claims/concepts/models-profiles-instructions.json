  "claims": [
    {
      "id": "claim_ef765ffe40a34bb6bad1e4c5916b0ee9",
      "statement": "SUPPORTED_MODELS is the curated registry of selectable models with hand-maintained ModelOption records (provider-prefixed id, label, per-model efforts list, default_effort, supports_images, and optionally can_be_default); SUPPORTED_MODEL_IDS is the frozen set every resolution layer checks membership against.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L1-L15",
          "version": "repo-lines-v1:sha256:39e3f85e20b5f1d3e4d6d1d97fb10afeadaa271b665d2c1bac85bb5669a98ac7:"
        }
      ]
    },
    {
      "id": "claim_8a191ee5184a40fc98f87cb4ebe8d4dd",
      "statement": "The efforts a model accepts are per-model and non-uniform (e.g. Kimi K3 only accepts low/high/max, only some advertise xhigh/max), and model_supports_effort/model_supports_images validate a stored selection against the model's own ModelOption fields.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L136-L148",
          "version": "repo-lines-v1:sha256:9d7631ab89cc4e17ad9143c9b9a697113e475e1c9b163a4c2c5996f73b5b2902:"
        }
      ]
    },
    {
      "id": "claim_bb46dfb2fe4042f588e5749237cf0336",
      "statement": "Deprecated model ids are not canonically replaced: DEPRECATED_MODEL_REPLACEMENTS has empty values and returns None for deprecated ids. Deprecated ids are excluded from provider_fallback_pair and defer to defaults, while unsupported non-deprecated ids may use same-provider and, where possible, same-Claude-family fallback; retired ids move to named successors in RETIRED_MODEL_REPLACEMENTS.",
      "evidence": [
        {
          "resource": "repo://openswe/dashboard/options.py#L161-L192",
          "version": "repo-lines-v1:sha256:b64d1eee52d65985d46e73ce9bb3412c99fe903ce3ef301100189a721fac8fce:"
