    {
      "id": "claim_0b45d3c4a4714434a5110ccf468a7cbd",
      "statement": "dispatch_agent_run routes Slack, Linear, GitHub, dashboard, and background triggers through create_durable_run, which applies durable LangGraph defaults: multitask_strategy='interrupt' (halts active run, preserves checkpoint, resumes with history), durability='async' (checkpoints before each step), stream_resumable=False (does not replay these runs' streams), Protocol v3 configuration (stream_mode values/updates/messages/custom/tasks/checkpoints, stream_subgraphs), and if_not_exists='create'.",
      "evidence": [
        {
          "resource": "repo://openswe/dispatch.py#L1-L25",
          "version": "repo-lines-v1:sha256:4a9bd84c0392c07c18c12c370c6d79b452ecadb44654a1bface6e858d493f5f4:"
        },
        {
