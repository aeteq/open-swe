    {
      "id": "claim_0b45d3c4a4714434a5110ccf468a7cbd",
      "statement": "dispatch_agent_run routes Slack, Linear, GitHub, dashboard, and background triggers through create_durable_run, which applies durable LangGraph defaults: multitask_strategy='interrupt' (halts active run, preserves checkpoint, resumes with history), durability='async' (checkpoints before each step), stream_resumable=False (does not replay these runs' streams), Protocol v3 configuration (stream_mode, stream_subgraphs), and if_not_exists='create'.",
      "evidence": [
        {
          "resource": "repo://openswe/dispatch.py#L1-L26",
          "version": "repo-lines-v1:sha256:9a3cc67cb837541bae3e0efbf1b1c33dbdb57dfa8c5593243796d0fc9a9b16a8:"
