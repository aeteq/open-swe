    {
      "id": "claim_0b45d3c4a4714434a5110ccf468a7cbd",
      "statement": "dispatch_agent_run routes every Slack/Linear/GitHub/dashboard trigger through create_durable_run, which applies durability='sync' (checkpoint before each step so a crash or recycle resumes from the last checkpoint) rather than per-site runs.create calls.",
