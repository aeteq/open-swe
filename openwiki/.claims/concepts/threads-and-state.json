  "claims": [
    {
      "id": "claim_59daaaa8396044a0ab47378f78878e79",
      "statement": "openswe/thread_ids.py is the single home for deterministic thread-id derivation, and every id is a cross-process routing contract that webhooks, the dashboard, and the reviewer each re-derive from the same external identifiers to find an existing thread, so changing a formula orphans live threads.",
      "evidence": [
        {
          "resource": "repo://openswe/thread_ids.py#L1-L7",
          "version": "repo-lines-v1:sha256:74407305d823d66ac0922ef8230aba3e627fd83f5284c729045a94b7992b419e:"
        }
      ]
    },
    {
      "id": "claim_3681e87a4b05434faa1958c0750175bb",
      "statement": "Thread ids are derived either as URL-namespaced UUIDv5 (Slack, PR-comment, reviewer, review-scout, review-shadow, review-chat, review-style) via uuid.uuid5(NAMESPACE_URL, key), or as a SHA-256-derived UUID (Notion pages/discussions and GitHub issues) via _sha256_uuid.",
      "evidence": [
        {
          "resource": "repo://openswe/thread_ids.py#L31-L86",
          "version": "repo-lines-v1:sha256:84048d0e70a0e343db49820c0e780cc487338f3c63af553445e2a168e8e16507:"
        }
      ]
    },
    {
      "id": "claim_e64f64c8bae24ee989219ae1057aabc8",
      "statement": "slack_thread_id keys a Slack thread on the string slack:{channel}:{timestamp}:{nonce}, so rotating the nonce changes the derived id for the same channel/timestamp.",
