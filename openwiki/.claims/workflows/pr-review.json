    {
      "id": "claim_6b9cedc420284e77ad83cbaab5ec1e04",
      "statement": "An explicit review request enters through trigger_pr_review_from_ref, which fetches PR metadata to resolve base/head SHAs, sets reviewer thread metadata with watch=True, posts a review-started comment, and dispatches a reviewer run; request_pr_review is the agent tool that parses a PR URL and invokes it.",
      "evidence": [
        {
          "resource": "repo://agent/github/webhook.py#L259-L370",
          "version": "repo-lines-v1:sha256:dd380d0718072c31dc33ede9378616b3ab336c0eea8a3bd2dcca9209d777343e:"
        }
      ]
    },
    {
      "id": "claim_cf6d73688358435ca9d7d15e24d4fa6b",
      "statement": "Every review of a given PR runs on one deterministic thread id, reviewer_thread_id(owner, repo, pr_number), a UUIDv5 over '{owner}/{repo}/pr/{pr_number}/reviewer' that webhooks, the dashboard, and the reviewer all re-derive from the same identifiers to address the same thread; the formula is a persisted-data contract whose change would orphan live threads.",
      "evidence": [
        {
          "resource": "repo://agent/thread_ids.py#L39-L40",
          "version": "repo-lines-v1:sha256:b8f278266ed450fa85811c34e7024180519fe8c4e14feecb733b454babf69111:"
        }
      ]
    },
    {
      "id": "claim_eb6dc3904eb54df4a9aa0143ab2b37d9",
      "statement": "Reviewer runs are dispatched with assistant_id='reviewer', which maps to the reviewer graph (agent.graphs.reviewer:traced_reviewer_agent), and the dispatched run id is stored on reviewer thread metadata via _store_current_reviewer_run_id.",
      "evidence": [
        {
          "resource": "repo://agent/github/webhook.py#L495-L506",
          "version": "repo-lines-v1:sha256:52dfaf18f27fba4fe0036db5e6b4ca4c103af4bc1a0078b273240e5a30e1353a:"
