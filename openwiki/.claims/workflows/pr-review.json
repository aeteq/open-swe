    },
    {
      "id": "claim_f48695824c724f459bfda1a0959aa75e",
      "statement": "Findings are persisted in PostgreSQL under the pull request they were raised on, with human replies on their GitHub threads linking to registered users by login; callers address them by reviewer thread, and thread metadata holds PR identity, head SHA, and watch flag.",
