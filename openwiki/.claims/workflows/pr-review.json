    },
    {
      "id": "claim_2c1455f351194f3390b1101ff8da4471",
      "statement": "Findings writes go through a locked read-modify-write layer: mutate_findings reads the freshest list and only persists when the mutator reports a change, replace_findings merges an incoming snapshot by id so concurrently-added findings are not dropped, and append_finding de-duplicates by fingerprint against open findings.",
      "evidence": [
        {
          "resource": "repo://agent/review/findings.py#L552-L615",
          "version": "repo-lines-v1:sha256:21940151efdc28a67b58d95e0b7727d61ea8c42f30d8daee9a7ea1c623afd2fb:"
        }
      ]
    },
    {
      "id": "claim_9d9ce4798cd543ad90ca5d82230e861f",
      "statement": "When the reviewer thread backing findings storage does not exist, the storage layer raises ReviewerThreadMissingError and tools return a structured do-not-retry result (thread_missing_tool_result) instead of blindly retrying.",
