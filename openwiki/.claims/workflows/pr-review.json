    {
      "id": "claim_461f9ff79f9b4874b75ab9013bf9a88b",
      "statement": "add_finding enforces in-diff-only discipline: it validates start_line..end_line against the diff line set for the file/side via is_range_in_diff and rejects out-of-diff findings with success:false and in_diff:false and an explicit do-not-retry message; file-level findings (both lines None) are accepted but do not render as inline comments.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/add_finding.py#L60-L76",
          "version": "repo-lines-v1:sha256:c53518a0ff3bf052ba508c0544c1897e01126f066f37d46a1d6f86af75aa97fa:"
        }
      ]
    },
    {
      "id": "claim_5080a69e1f924aa7b8af8404170dfcac",
      "statement": "add_finding requires a non-default generated title, validates severity/confidence/side enums, and clips suggestions longer than the 4-line cap (MAX_SUGGESTION_LINES) — dropping the suggestion while keeping the description-only finding.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/add_finding.py#L28-L123",
