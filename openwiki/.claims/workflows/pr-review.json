    {
      "id": "claim_6b9cedc420284e77ad83cbaab5ec1e04",
      "statement": "An explicit @open-swe/dashboard review request enters through trigger_pr_review_from_ref, which fetches PR metadata to resolve base/head SHAs, sets reviewer thread metadata with watch=True, posts a review-started comment, and dispatches a reviewer run; request_pr_review is the agent tool that parses a PR URL and invokes it.",
      "evidence": [
        {
          "resource": "repo://agent/github/webhook.py#L233-L351",
          "version": "repo-lines-v1:sha256:a0a698d47f2c129e59c9529adf60ae93e8ac094b62a09803dd974f1cd5d7b156:"
        },
        {
