    },
    {
      "id": "claim_461f9ff79f9b4874b75ab9013bf9a88b",
      "statement": "add_finding enforces in-diff-only discipline: it validates start_line..end_line against the diff line set for the file/side via is_range_in_diff and rejects out-of-diff findings with success:false and in_diff:false and an explicit do-not-retry message; file-level findings (both lines None) are accepted but do not render as inline comments.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/add_finding.py#L60-L75",
          "version": "repo-lines-v1:sha256:74179a0ae855553ec6119b66c31de88706893128069b189bdec8eeb8e40325f3:"
        }
      ]
    },
    {
      "id": "claim_5080a69e1f924aa7b8af8404170dfcac",
      "statement": "add_finding requires a non-default generated title, validates severity/confidence/side enums, and clips suggestions longer than the 4-line cap (MAX_SUGGESTION_LINES) — dropping the suggestion while keeping the description-only finding.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/add_finding.py#L42-L123",
          "version": "repo-lines-v1:sha256:09ab6c6f078a3a7aa10604a5c06e3b56ab4f68cefa287df526bd098e66115010:"
        }
      ]
    },
    {
      "id": "claim_63861acb8731459882fd0254887c92c7",
      "statement": "Severity is ordered low < medium < high < critical (SEVERITY_ORDER); filter_findings_for_publish surfaces only open findings at or above the severity_threshold (default medium), sorted severity-descending then file/line. Confidence is recorded per finding but does not gate publication.",
      "evidence": [
        {
          "resource": "repo://openswe/review/findings.py#L107-L125",
          "version": "repo-lines-v1:sha256:7785ff303ccd11b84ed600fc8a83d01a34767cd0e2c8915c0f15eb34e9627bb3:"
        }
      ]
    },
    {
      "id": "claim_cfcb516eadd04b31a8028dfdcb9a12ae",
      "statement": "publish_review posts eligible findings as a single GitHub PR Review with inline comments (path+line+side, metadata marker, optional fenced suggestion block) and a host-formatted summary body; on a re-review it drops already-surfaced findings so only net-new findings are posted.",
      "evidence": [
        {
          "resource": "repo://openswe/tools/publish_review.py#L316-L427",
          "version": "repo-lines-v1:sha256:71f33b90c9fe8da34d755e28ef68a6cf1cbe688acaa48a6f028e03dc7821f838:"
        }
      ]
    },
    {
      "id": "claim_a6d91e1cdd454a7b83894cd11d6640bd",
      "statement": "publish_review resolves the effective head SHA from thread metadata (a mid-run push updates the live head there ahead of the run's frozen config), then records the GitHub review id and per-comment/thread ids back onto each finding to avoid a surfaced-but-unrecorded state.",
      "evidence": [
        {
          "resource": "repo://openswe/review/findings.py#L474-L487",
          "version": "repo-lines-v1:sha256:e7ce3e925e0648525dc4ec81d1404f25102935ed901de0daae3ddd572cd19728:"
