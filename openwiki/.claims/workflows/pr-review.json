  "claims": [
    {
      "id": "claim_f75cd879d07b45f29d210694a643b7cf",
      "statement": "GitHub webhook deliveries land on a single signed endpoint (POST /webhooks/github) that verifies the X-Hub-Signature-256 HMAC, ignores unsupported event types, and dispatches the matching handler as a FastAPI background task.",
      "evidence": [
        {
          "resource": "repo://agent/github/routes.py#L11-L50",
          "version": "repo-lines-v1:sha256:5b49f3ef744dd59adcf6d12146c8f4cf7799c6987e51170960ca4ee8ea06c214:"
        }
      ]
    },
    {
      "id": "claim_010d9ee483a14657a949f7760d5c5d4f",
      "statement": "Auto-review on PR opened/ready_for_review is scheduled only when the repository is opted into automatic review (_is_repo_auto_review_enabled), delegating to is_review_repo_enabled which fails soft — an unreachable enabled-repos store reads as 'not opted in' and skips the review rather than erroring the webhook.",
      "evidence": [
        {
          "resource": "repo://agent/github/routes.py#L76-L97",
          "version": "repo-lines-v1:sha256:c778ecc5f1e9c59c1403f6bb5bdbc98093dc3fffc71f2ee4c13c808849109285:"
        },
        {
