          "version": "repo-lines-v1:sha256:5e0a47b6cf9c7777f7ec47fd445232aae3377991eec938f590f66d461c380b72:"
        }
      ]
    },
    {
      "id": "claim_eb6dc3904eb54df4a9aa0143ab2b37d9",
      "statement": "Reviewer runs are dispatched with assistant_id='reviewer', which maps to the reviewer graph (agent.graphs.reviewer:traced_reviewer_agent), and the dispatched run id is stored on reviewer thread metadata via _store_current_reviewer_run_id.",
      "evidence": [
