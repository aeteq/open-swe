    },
    {
      "id": "claim_63861acb8731459882fd0254887c92c7",
      "statement": "Severity is ordered low < medium < high < critical (SEVERITY_ORDER); filter_findings_for_publish surfaces only open findings at or above the severity_threshold (default medium), sorted severity-descending then file/line, capped at REVIEW_FINDING_CAP (6). Confidence is recorded per finding but does not gate publication.",
      "evidence": [
        {
          "resource": "repo://agent/review/findings.py#L81-L107",
          "version": "repo-lines-v1:sha256:36445fa3d4e552496733b5a5f121742685f0a754254bee44fa5f85043e754a18:"
        }
      ]
    },
    {
      "id": "claim_cfcb516eadd04b31a8028dfdcb9a12ae",
      "statement": "publish_review posts eligible findings as a single GitHub PR Review with inline comments (path+line+side, metadata marker, optional fenced suggestion block) and a fixed host-formatted summary body the agent never writes; on a re-review it drops already-surfaced findings so only net-new findings are posted.",
      "evidence": [
        {
          "resource": "repo://agent/review/publish.py#L1-L20",
          "version": "repo-lines-v1:sha256:d6b0a6a10ddd9626ca6b846f28b0cb587114e68169ad9260e4a3009fa08fb694:"
        },
        {
          "resource": "repo://agent/tools/publish_review.py#L75-L120",
          "version": "repo-lines-v1:sha256:480ac527c7b552474a1ee5104d3d28cb24a9159517d27e2f594b930b50aeda3d:"
        }
      ]
    },
    {
      "id": "claim_a6d91e1cdd454a7b83894cd11d6640bd",
      "statement": "publish_review resolves the effective head SHA from thread metadata (a mid-run push updates the live head there ahead of the run's frozen config), then records the GitHub review id and per-comment/thread ids back onto each finding in a single write to avoid a surfaced-but-unrecorded state.",
      "evidence": [
        {
          "resource": "repo://agent/tools/publish_review.py#L270-L310",
          "version": "repo-lines-v1:sha256:5e871704a0aec854d985328ed82fd36545368a5090816af4cf5954cdb007473f:"
        }
      ]
    },
    {
      "id": "claim_235f037a937f4c04903a6991e528fc8c",
      "statement": "publish_review handles edge cases explicitly: on a 422 unresolved-anchor rejection it drops the offending findings, retries once, and returns unresolvable_findings; an empty re-review with an existing Open SWE summary skips a new summary (skipped_empty_re_review, review_id:null) but still resolves fixed threads and advances last_reviewed_sha; eval mode is a dry_run that posts nothing. Only a numeric review_id with neither flag confirms a real review was posted.",
      "evidence": [
        {
          "resource": "repo://agent/tools/publish_review.py#L330-L480",
          "version": "repo-lines-v1:sha256:cff796899b64a8d809c244b472a660e9dfcc71af6d216bf034eebee3f1c8428b:"
        },
        {
          "resource": "repo://agent/tools/publish_review.py#L98-L120",
          "version": "repo-lines-v1:sha256:55fd01a3fa1d958c79653259a9a4ff01f1e86aeda2166a6b417ea19eb28d5ada:"
        }
      ]
    },
    {
      "id": "claim_75f859e800d04af4a53cd409d62afc7a",
      "statement": "process_github_pr_close toggles the reviewer thread watch flag on PR lifecycle transitions: reopened re-enables watch, closed disables it, and converted_to_draft disables watch only when the author's effective draft-review setting is off.",
      "evidence": [
        {
