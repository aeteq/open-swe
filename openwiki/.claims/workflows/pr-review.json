    {
      "id": "claim_f48695824c724f459bfda1a0959aa75e",
      "statement": "A PR has a single evolving findings list persisted on the reviewer thread's metadata (under 'findings', keyed by kind == 'reviewer'), chosen because thread metadata survives sandbox eviction and is queryable cross-thread via the LangGraph SDK.",
      "evidence": [
        {
          "resource": "repo://agent/review/findings.py#L1-L50",
          "version": "repo-lines-v1:sha256:9111f9a9122d9af078c9f467a014a10a0eada43836155f9d929def9a5444ddbd:"
        }
      ]
    },
    {
      "id": "claim_5f840e3acfcc4c91bd31a8f9ff5ba716",
      "statement": "Persisted finding records are normalized on every read by coerce_finding, which folds legacy flat-singular GitHub-identity fields and a nested 'surface' record into the canonical comment/thread id lists plus surface_state so the rest of the codebase never sees the legacy shape.",
      "evidence": [
        {
          "resource": "repo://agent/review/findings.py#L109-L150",
          "version": "repo-lines-v1:sha256:5aa541ae1d153bb622093796661c6481e91b4d5013a6880fa0b1a533cf5f57ff:"
        }
      ]
    },
    {
      "id": "claim_2c1455f351194f3390b1101ff8da4471",
      "statement": "Findings writes go through a locked read-modify-write layer: mutate_findings reads the freshest list and only persists when the mutator reports a change, replace_findings merges an incoming snapshot by id so concurrently-added findings are not dropped, and append_finding de-duplicates by fingerprint against open findings.",
      "evidence": [
        {
          "resource": "repo://agent/review/findings.py#L490-L600",
          "version": "repo-lines-v1:sha256:b3e53cb8a5eed938fb7a57bf6ae6e01538e45f9cd2d792a9d6e0061ee0cc4e3a:"
        }
      ]
    },
    {
      "id": "claim_9d9ce4798cd543ad90ca5d82230e861f",
      "statement": "When the reviewer thread backing findings storage does not exist, the storage layer raises ReviewerThreadMissingError and tools return a structured do-not-retry result (thread_missing_tool_result) instead of blindly retrying.",
      "evidence": [
        {
          "resource": "repo://agent/review/findings.py#L32-L50",
          "version": "repo-lines-v1:sha256:ff8fe902dad76a5b736802bcd5c1e5d01845c24810ecdf2b57518236ae07af2b:"
