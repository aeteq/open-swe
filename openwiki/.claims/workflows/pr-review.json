  "claims": [
    {
      "id": "claim_f75cd879d07b45f29d210694a643b7cf",
      "statement": "GitHub webhooks are delivered to MDA's GitHub channel, which verifies each signature and dispatches it to the backend; the backend processes work handlers synchronously (including background tasks) and admits events subject to public-repo and organization gates.",
      "evidence": [
        {
          "resource": "repo://openswe/github/channel.py#L1-L50",
          "version": "repo-lines-v1:sha256:1e7752f5b2e495e6941558f62c3ef023c7dcd9bfb074b5b9b3d10814c9f9d962:"
        },
        {
