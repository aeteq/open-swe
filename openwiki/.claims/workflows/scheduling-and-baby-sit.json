        }
      ]
    },
    {
      "id": "claim_c0ca9b93d007455891fa2d0a1a6a2dfa",
      "statement": "The reconcile sweep wraps per-thread work in try/except so one bad thread never aborts the sweep, and returns counts of threads checked, stale runs found, and runs cancelled.",
