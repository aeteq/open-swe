    {
      "id": "claim_5c10bff511e1486a927941d0933d5dfa",
      "statement": "launch_scheduled_agent_run is the agent_schedule job handler: it loads a stored schedule record, creates a fresh agent run, and records last_thread_id / last_run_id / last_triggered_at (or last_error) in a separate schedule run-state namespace, with deduplication via event_claims ensuring the same schedule fire never launches twice even after deploy/crash.",
      "evidence": [
