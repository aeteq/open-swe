  "claims": [
    {
      "id": "claim_851e23a08e794421a0ac06c407e8a9d0",
      "statement": "The job queue (openswe/jobs/queue.py, openswe/jobs/worker.py) stores work in the `job` table by UUID with a `kind` and `payload`, running one-shot or cron-repeated jobs through the JobWorker which claims and dispatches each to its registered handler without invoking an LLM; when a handler raises an error, the job is retried with exponential back-off (30s × 2^(attempts-1), capped at 1 hour) up to 5 attempts, with cron jobs skipping to their next fire on failure and one-shot jobs deleting themselves after exhausting retries.",
      "evidence": [
        {
          "resource": "repo://openswe/jobs/queue.py#L1-L150",
          "version": "repo-lines-v1:sha256:30a3bb16b395c634acfcc3d5f5099a79aad1665b5ff317dab6f5afc3a6dc01fe:"
        },
        {
