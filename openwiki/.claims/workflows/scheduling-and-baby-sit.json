        }
      ]
    },
    {
      "id": "claim_57e56d5d78ff40fab76d5cf2f12301e8",
      "statement": "Dashboard-managed recurring agent schedules validate cron strings with normalize_cron_schedule, which requires a five-field expression and range-checks each field (supporting steps, ranges, and lists) before a schedule is stored.",
      "evidence": [
        {
          "resource": "repo://openswe/schedules/store.py#L239-L246",
