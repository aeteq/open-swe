        }
      ]
    },
    {
      "id": "claim_0bb912cb3a9640c48496979a94cd5845",
      "statement": "Because dispatch uses multitask_strategy='interrupt', a thread never provisions two sandboxes concurrently, which removed the need for the old in-process busy-check, lock, and cross-process sentinel.",
