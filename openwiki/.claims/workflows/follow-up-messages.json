        }
      ]
    },
    {
      "id": "claim_fb28f0a3fca8491d85514b78d5f93785",
      "statement": "With multitask_strategy='interrupt', a follow-up run on a busy thread halts the active run and resumes the agent with full conversation history plus the new message, while an idle thread simply starts a run.",
      "evidence": [
        {
          "resource": "repo://agent/dispatch.py#L1-L26",
          "version": "repo-lines-v1:sha256:e71c74fc5048f1e615b592f848c5845a1f9a22d9d5c85c85ce993cebbca90080:"
        }
      ]
    },
    {
      "id": "claim_ad59563295d04e3c9e4c4d430121fa68",
      "statement": "dispatch runs use durability='sync' (a checkpoint before each step) so an interrupted or crashed run resumes from its last checkpoint rather than losing progress.",
      "evidence": [
        {
          "resource": "repo://agent/dispatch.py#L10-L11",
          "version": "repo-lines-v1:sha256:0aff97cf6d67d2647eaad12430e6666e11b419f522a063d9b383693d2d6ebb93:"
