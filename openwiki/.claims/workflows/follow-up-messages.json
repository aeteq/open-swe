        }
      ]
    },
    {
      "id": "claim_76af7890deaf41f48cb7a81af78a0b59",
      "statement": "Background and low-priority follow-ups opt out of interruption with multitask_strategy='enqueue', letting the active run finish before the queued run starts; /baby-sit updates and background-task runs use enqueue.",
