    {
      "id": "claim_3b1b07aeac4b4d8b811c397903ae1694",
      "statement": "`dispatch_agent_run` is the common agent/reviewer dispatch contract: it constructs or accepts structured `RunInput` and delegates to `create_durable_run`, which invokes `client.runs.create` with a caller-selectable multitask strategy that defaults to `\"interrupt\"`.",
      "evidence": [
        {
          "resource": "repo://openswe/dispatch.py#L354-L426",
          "version": "repo-lines-v1:sha256:5dcf840241302b067804c02037c7757394ee00240498aa9c188fc6e7bc1a5838:"
        },
