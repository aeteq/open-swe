        }
      ]
    },
    {
      "id": "claim_29384be9541d4107a6629b02c10a3710",
      "statement": "Durable dispatch uses `durability=\"async\"`, Protocol v2 stream modes with `stream_mode` including \"values\", \"updates\", \"messages\", \"custom\", \"tasks\", and \"checkpoints\", subgraph streaming enabled, and per-dispatch run-specific metadata; those settings preserve a checkpoint before each step and let dashboard clients replay runs they did not create.",
      "evidence": [
        {
          "resource": "repo://openswe/dispatch.py#L393-L403",
          "version": "repo-lines-v1:sha256:990dfef5d1f5d5f1d69f78c602cf57142ccdffafe37d40afd63b1211bfc97870:"
