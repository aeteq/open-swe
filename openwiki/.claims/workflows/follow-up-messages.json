    {
      "id": "claim_910063f7ea934eaea8ee4841b6ae243f",
      "statement": "Baby-sit terminal/failure updates and completed sandbox-background-task notifications use `multitask_strategy=\"enqueue\"`, allowing interactive work to finish before their follow-up run starts.",
