    {
      "id": "claim_a85f5e993f3343298671c4aa9fc9ff3e",
      "statement": "When a dashboard user sends a follow-up to a busy thread, the system routes it based on thread activity and multitask strategy: steering injects the message into the active run's next model call via the message queue, enqueueing creates a new run with `multitask_strategy=\"enqueue\"`, and an idle thread gets a new run immediately. The system authorizes the sender and returns 409 if a machine principal attempts to interact with a busy thread, or 502 if queueing fails.",
      "evidence": [
        {
          "resource": "repo://openswe/threads/proxy.py#L197-L249",
          "version": "repo-lines-v1:sha256:359e751bc1e2e235801fede90a24b78c321b5793f099dd10e8df37f0a53b32b5:"
