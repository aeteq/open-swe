    {
      "id": "claim_3b1b07aeac4b4d8b811c397903ae1694",
      "statement": "`dispatch_agent_run` is the common agent/reviewer dispatch contract: it constructs or accepts structured `RunInput` and delegates to `create_durable_run`, which invokes `client.runs.create` with a caller-selectable multitask strategy that defaults to `\"interrupt\"`.",
      "evidence": [
        {
          "resource": "repo://openswe/dispatch.py#L541-L565",
          "version": "repo-lines-v1:sha256:8d93ab70255e03074f21e95d146373e13cf67d6c8c32df0c07baf51efc39cfbf:"
        }
      ]
    },
    {
      "id": "claim_29384be9541d4107a6629b02c10a3710",
      "statement": "Durable dispatch uses `durability=\"async\"`, Protocol v2 stream modes with `stream_mode` including \"values\", \"updates\", \"messages\", \"custom\", \"tasks\", and \"checkpoints\", subgraph streaming enabled, and per-dispatch run-specific metadata; those settings preserve a checkpoint before each step and let dashboard clients replay runs they did not create.",
      "evidence": [
        {
          "resource": "repo://openswe/dispatch.py#L145-L152",
          "version": "repo-lines-v1:sha256:d409342cc3a4dfb62d931d5364dd34097559070b3bbfd6d7831ea423b9248ea7:"
