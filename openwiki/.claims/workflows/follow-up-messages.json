    {
      "id": "claim_b7ce66a8a9a949e39ec3caa37aa0f6bf",
      "statement": "Every Slack, Linear, GitHub, and dashboard trigger routes through dispatch_agent_run, which forwards a multitask_strategy (default 'interrupt') to create_durable_run and finally to client.runs.create.",
      "evidence": [
        {
          "resource": "repo://agent/dispatch.py#L228-L270",
          "version": "repo-lines-v1:sha256:c12962297db2ac6398cf8812a7331d754bde216c99c487e4ce67f5cc802e887d:"
        },
        {
          "resource": "repo://agent/dispatch.py#L273-L322",
