  "claims": [
    {
      "id": "claim_891b77550a3f45fba188f6301b4029e1",
      "statement": "Open SWE selects the sandbox implementation for a run at runtime from the SANDBOX_TYPE environment variable, which create_sandbox() in agent/sandboxes/providers/registry.py reads and defaults to \"langsmith\".",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L76-L77",
          "version": "repo-lines-v1:sha256:60203592aff4059940b99e91d3ca85ac9cb5c8b307b59260cd5817d57f1b61e7:"
        }
      ]
    },
    {
      "id": "claim_8e771a58238a4aaaa4808c8a795757fb",
      "statement": "SANDBOX_FACTORIES in agent/sandboxes/providers/registry.py maps each provider name (langsmith, daytona, modal, runloop, e2b, local) to a (module, function) tuple that is imported lazily via import_module, so only the selected provider's module and SDK dependency are loaded at runtime.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L22-L42",
          "version": "repo-lines-v1:sha256:f7bfaab451412a3914047120624e8fbd0a98e4303474e186a12ac1e2a7c18c20:"
        }
      ]
    },
    {
