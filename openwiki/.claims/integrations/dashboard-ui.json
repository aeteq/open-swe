    {
      "id": "claim_dbbc3ca9eca441849138011e70eadf76",
      "statement": "The dashboard backend is a single FastAPI APIRouter created in agent/dashboard/routes.py with prefix \"/dashboard/api\", and it is mounted onto the composed FastAPI app in agent/api/app.py via app.include_router(dashboard_router).",
      "evidence": [
        {
          "resource": "repo://agent/api/app.py#L58-L58",
          "version": "repo-lines-v1:sha256:4861b87ed7497fac3e00c23743ead220a0aaf1256adc39aa7d09fae6aecdeb24:"
        },
        {
          "resource": "repo://agent/dashboard/routes.py#L267-L271",
          "version": "repo-lines-v1:sha256:b2142f8f7618bb20374837dc6826b6846f3ecbba64b027cb0d916ec6f3f35268:"
        }
      ]
    },
    {
      "id": "claim_5137f84b36be4cd59aa0cf6c902aa4f2",
      "statement": "agent/dashboard/__init__.py exposes the router lazily via a PEP 562 __getattr__ so that importing a dashboard submodule does not drag in routes.py, FastAPI, and every API/job module; only the webapp that mounts the router pays that import cost.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/__init__.py#L17-L23",
          "version": "repo-lines-v1:sha256:0172aa125f1b1c36a14f0230f9c8357450d34c855db381befc2b184c99eef552:"
        }
      ]
    },
    {
      "id": "claim_1311bde23f634fc0aa3ffa2720da972a",
      "statement": "GitHub login issues a signed state carrying a hashed nonce stored in a short-lived state cookie and redirects to GitHub's authorize URL; the callback validates the state nonce against the cookie, exchanges the code, enforces an organization login gate, persists the token, and issues a signed session JWT in the session cookie.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/routes.py#L459-L547",
          "version": "repo-lines-v1:sha256:f1ae0243aa2d04a76c3fae0eddd1d1f307f420ea209fc288fcd6ecdff9659b91:"
        }
      ]
    },
    {
      "id": "claim_a9f05ddeca304982992bd67bdc104d6c",
      "statement": "Session cookie Secure/SameSite flags are derived from the API scheme: an HTTPS DASHBOARD_API_BASE_URL yields Secure; SameSite=None (cross-site production), otherwise local http falls back to SameSite=Lax without Secure.",
      "evidence": [
        {
          "resource": "repo://agent/dashboard/oauth.py#L148-L165",
          "version": "repo-lines-v1:sha256:4fd70898bcfac817628969ac3b36a513f8d9b2ad5a68a51daee4574ec3132d2f:"
        }
      ]
    },
    {
