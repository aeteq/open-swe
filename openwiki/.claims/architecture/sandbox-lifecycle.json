  "claims": [
    {
      "id": "claim_2b3f3f7d85234994b70015fa6cef3b76",
      "statement": "The sandbox provider is selected at runtime from the SANDBOX_TYPE environment variable, defaulting to 'langsmith', with supported values langsmith, daytona, modal, runloop, e2b, and local.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L23-L30",
          "version": "repo-lines-v1:sha256:7c267a30d686b7c8671e034f8e21f02c5ae2212db81833c81604c24796d6149d:"
        },
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L77-L78",
          "version": "repo-lines-v1:sha256:64e9606f77c7ae66f010831426cd6b63616d99b8453d21a8cb1ad564e7585492:"
        }
      ]
    },
    {
      "id": "claim_3dc701e02da54d628562b66379699bca",
      "statement": "SANDBOX_FACTORIES maps each SANDBOX_TYPE value to a (module, function) pair, and _load_sandbox_factory imports and returns that factory, raising ValueError for an unknown sandbox type.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L23-L42",
          "version": "repo-lines-v1:sha256:21e5bfb22c5b53946fe5685d187024f37dccfc0f5979e96ce827f3fe671241e4:"
        }
      ]
    },
    {
      "id": "claim_cd39455a54a74b96b2df43a7caad758b",
      "statement": "create_sandbox is the single entrypoint for provisioning: it awaits langsmith and modal directly because they provision natively async, and runs local, daytona, e2b, and runloop via asyncio.to_thread because their setup binds synchronous SDK handles or does synchronous filesystem I/O.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L45-L94",
          "version": "repo-lines-v1:sha256:3e9fe0b80283199b29e677cccb19f1a2ae6451e367b26f95fe349493d40c52ff:"
        }
      ]
    },
    {
      "id": "claim_ea4bf8bf5b2a439bab90b17edcf15c4a",
      "statement": "Only the langsmith factory receives the snapshot_id/mem_bytes/vcpus/fs_capacity_bytes/create_params overrides; other providers ignore them.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L79-L91",
          "version": "repo-lines-v1:sha256:21a07d70e36bf7fc644ae4e05b60ca5b249fa6594f7c157b1cf8b0b49f7df035:"
        }
      ]
    },
    {
      "id": "claim_3a1ff513ed604dfe993e49af5af51c99",
      "statement": "SANDBOX_BACKENDS is an in-process dict keyed by thread_id holding a stable SandboxBackendProxy per thread, shared between the server and middleware as an in-memory cache that does not survive worker restarts.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L319-L320",
          "version": "repo-lines-v1:sha256:d209c0930a10e2dac0e6918cf466421e7935c9313d6a92d963b715040039c7d8:"
        }
      ]
    },
    {
      "id": "claim_62534f403078492aa865de44d1176465",
      "statement": "A thread's durable binding to its sandbox is the sandbox_id persisted in thread metadata; get_sandbox_id_from_metadata reads it (falling back to a live thread lookup) and fails open to no sandbox on error, letting any later run on any worker reconnect to the same box.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L365-L393",
          "version": "repo-lines-v1:sha256:a7cd6f6b2ed9979e24a8de27e005314e28c9a9cde6499b54ca9aea085657eff8:"
        }
      ]
    },
    {
      "id": "claim_21430c95060a4ae9abbf74019aeede0a",
      "statement": "SandboxBackendProxy is a stable per-thread handle whose target can be replaced; it subclasses BaseSandbox (not merely the protocol) so FilesystemMiddleware recognizes it as capture-at-source capable and keeps the in-sandbox stdout size cap on the execute offload path.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L53-L61",
          "version": "repo-lines-v1:sha256:26466a8c75330899dbb9ca6605cdb7d1e06cf7bdac2c139996a9023e5732deb0:"
        }
      ]
    },
    {
      "id": "claim_f33d48d63e1145929ce5799b993ffb5e",
      "statement": "SandboxBackendProxy is async-only: its synchronous methods raise NotImplementedError, while _aget_backend lazily reconnects (via a registered reconnect callback or by creating a sandbox from the metadata sandbox_id), serializes concurrent callers behind a lock, and caches the resolved backend back into SANDBOX_BACKENDS.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L140-L186",
          "version": "repo-lines-v1:sha256:37492c48f344757f46b2ea0f1ae646b8e23a6009251f08a3c824abd44a250fba:"
        }
      ]
    },
    {
      "id": "claim_419b5b3500cd4609a8c39850bfc9523a",
      "statement": "ensure_sandbox_for_thread is the get-or-create-then-reconnect entrypoint that guarantees a healthy sandbox bound to a thread; because dispatch uses multitask_strategy=interrupt a thread never provisions two sandboxes concurrently, so no cross-process sentinel is needed.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L290-L327",
          "version": "repo-lines-v1:sha256:ef7c209530a84b3faf2ad64fff3dd4b1aa5bc003228017abf22fc95e8ec2a6dc:"
        }
      ]
    },
    {
      "id": "claim_8bc4c3ca37dd4597a07ae4498d608ddd",
      "statement": "ensure_sandbox_for_thread handles three cases: reuse an in-memory cached backend, reconnect using the metadata sandbox_id, or create a new sandbox when neither exists.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L328-L370",
          "version": "repo-lines-v1:sha256:48cbf45d68c3a1a40bb96db7656996c5fe9ad3a93bd11d03315a4619ff3abb1b:"
        }
      ]
    },
    {
      "id": "claim_e2bc4e74d24044cfbbb2de2df2f6ca85",
      "statement": "ensure_sandbox_for_thread persists the thread's sandbox_id into thread metadata only after the sandbox is created and initialized, and publishes the backend into SANDBOX_BACKENDS via set_sandbox_backend last, so a run that fails during initialization leaves no id to adopt and does not expose a half-initialized backend to the rest of the run.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L405-L419",
          "version": "repo-lines-v1:sha256:d2a6e2174762fd5259cd565c53763874427a9facd395c28695e6ba340366b3d8:"
        }
      ]
    },
    {
      "id": "claim_f1c6007e99544682aecd264525eea1f7",
      "statement": "SandboxUnreachableError means the sandbox did not answer this run but may answer the next; it is never resolved by creating a replacement by default because the sandbox holds the agent's only copy of its working tree and an empty replacement would silently discard uncommitted work.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L372-L375",
          "version": "repo-lines-v1:sha256:2f1d5e1f476820f5303bccc69e2eb0e6c3d8dec4bab32490d81b206afe3bf055:"
        },
        {
          "resource": "repo://agent/sandboxes/state.py#L32-L47",
          "version": "repo-lines-v1:sha256:036a975b6954afd9535858d390798ef265c98681531108069269065b746a1285:"
        }
      ]
    },
    {
      "id": "claim_121db4cece024a1d96ac69e50d5c9d70",
      "statement": "allow_replacement=True extends replacement to merely unreachable sandboxes and is used only by the reviewer, whose sandbox holds only a checkout it re-derives every run and whose per-PR threads outlive their sandboxes, so refusing to replace would brick reviews on that PR.",
      "evidence": [
        {
          "resource": "repo://agent/reviewer.py#L952-L964",
          "version": "repo-lines-v1:sha256:a813d00bfc6596a8d4433594d4ba2143e0da19be78a909eb62813e7692cbf787:"
        },
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L316-L318",
          "version": "repo-lines-v1:sha256:9934a8a13d673c3d1ef85e0062b30e39d8f58f1205df5fc1bcc201a3c0566630:"
        },
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L372-L375",
          "version": "repo-lines-v1:sha256:2f1d5e1f476820f5303bccc69e2eb0e6c3d8dec4bab32490d81b206afe3bf055:"
        }
      ]
    },
    {
      "id": "claim_833c6af65eb846099304fcfe31b6dd9a",
      "statement": "When replacing an unreachable or deleted sandbox itself fails, the error is re-raised as SandboxUnreachableError so callers still recognize the run has no sandbox and can notify the user.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L391-L402",
          "version": "repo-lines-v1:sha256:1f91ee8f8dd57289e32a64f77165091f0b5c4661e0cdd7e21d182a098de4f7e2:"
        }
