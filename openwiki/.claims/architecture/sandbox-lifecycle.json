    {
      "id": "claim_3b64f2ebbcdf47b2bf3c62e81777d42c",
      "statement": "New sandboxes boot from the environment's ready snapshot when one exists, otherwise the admin-configured base snapshot (falling back to DEFAULT_SANDBOX_SNAPSHOT_ID), resolved by SandboxCreateConfig.resolve alongside VM sizing and create parameters.",
