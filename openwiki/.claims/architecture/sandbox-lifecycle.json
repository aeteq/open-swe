        }
      ]
    },
    {
      "id": "claim_145be700471b47a5b76ec4a02bd65081",
      "statement": "The LangSmith GitHub proxy injects credentials on the wire so no real GitHub token is written to disk in the sandbox: _github_proxy_rules sets an Authorization Basic header (base64 of x-access-token:token) for github.com and *.github.com and an Authorization Bearer header for api.github.com, plus a placeholder GH_TOKEN env var because gh refuses to run without a token in its environment.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/langsmith.py#L221-L249",
          "version": "repo-lines-v1:sha256:37449046e486bcd1a3644d657a4d5a057cb0a7fbd8d1b11e70feae5371f2643e:"
        }
      ]
    },
    {
      "id": "claim_a6d8ebc50d7b4943a1988081c95ebd3f",
      "statement": "The GitHub proxy token is minted at runtime from the GitHub App installation credentials via _resolve_proxy_token and is never stored as a deployment environment variable.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L49-L56",
