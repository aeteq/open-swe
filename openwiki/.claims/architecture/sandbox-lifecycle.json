    {
      "id": "claim_d9b6b92574b041a7bb21682f1c8d1f46",
      "statement": "Because the LangSmith proxy-config API rejects updates on a sandbox that is not ready, _configure_github_proxy responds to a not-ready status by best-effort starting the (stopped, not deleted) sandbox and retrying the PATCH, and retries transient failures with backoff.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/langsmith.py#L440-L492",
          "version": "repo-lines-v1:sha256:0f20f58c90787916fc4173d2556834b54e84499349854c430498422a32f3eab0:"
        }
