  "claims": [
    {
      "id": "claim_2b3f3f7d85234994b70015fa6cef3b76",
      "statement": "The sandbox provider is selected at runtime from the SANDBOX_TYPE environment variable, defaulting to 'langsmith', with supported values langsmith, daytona, modal, runloop, e2b, and local.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L22-L29",
          "version": "repo-lines-v1:sha256:7c267a30d686b7c8671e034f8e21f02c5ae2212db81833c81604c24796d6149d:"
        },
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L76-L76",
          "version": "repo-lines-v1:sha256:118da944ee2305f189ec8e4e29c45a2f4ad615f9e4b5fcf7a0460f5a62b9ad04:"
        }
      ]
    },
    {
      "id": "claim_3dc701e02da54d628562b66379699bca",
      "statement": "SANDBOX_FACTORIES maps each SANDBOX_TYPE value to a (module, function) pair, and _load_sandbox_factory imports and returns that factory, raising ValueError for an unknown sandbox type.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L22-L41",
          "version": "repo-lines-v1:sha256:21e5bfb22c5b53946fe5685d187024f37dccfc0f5979e96ce827f3fe671241e4:"
        }
      ]
    },
    {
      "id": "claim_cd39455a54a74b96b2df43a7caad758b",
      "statement": "create_sandbox is the single entrypoint for provisioning: it awaits langsmith and modal directly because they provision natively async, and runs local, daytona, e2b, and runloop via asyncio.to_thread because their setup binds synchronous SDK handles or does synchronous filesystem I/O.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L44-L93",
          "version": "repo-lines-v1:sha256:6328d75be23379acb12e4bd03a90dae2622f5df26039458addd5bb1339def7c1:"
        }
      ]
    },
    {
      "id": "claim_ea4bf8bf5b2a439bab90b17edcf15c4a",
      "statement": "Only the langsmith factory receives the snapshot_id/mem_bytes/vcpus/fs_capacity_bytes/create_params overrides; other providers ignore them.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L78-L93",
          "version": "repo-lines-v1:sha256:1f87b27c63aeee62ee531facca699801d9c8264e8a326facfedb9c26ed755c1e:"
        }
      ]
    },
    {
      "id": "claim_cf035b87ed964b63b83cc4bc42da2b31",
      "statement": "validate_sandbox_startup_config runs the active provider's configuration validation at server startup so config errors surface at boot rather than on first sandbox creation; for langsmith it delegates to LangSmithProvider.validate_startup_config, which only warns (non-fatally) when DEFAULT_SANDBOX_SNAPSHOT_ID is unset and validates the numeric DEFAULT_SANDBOX_* variables parse as integers.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L96-L107",
          "version": "repo-lines-v1:sha256:ad8c468a2e560c28d1829ae70261182c4bb88c13da5893ce1458b14f8259bf4d:"
        }
      ]
    },
    {
      "id": "claim_3a1ff513ed604dfe993e49af5af51c99",
      "statement": "SANDBOX_BACKENDS is an in-process dict keyed by thread_id holding a stable SandboxBackendProxy per thread, shared between the server and middleware as an in-memory cache that does not survive worker restarts.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L319-L320",
          "version": "repo-lines-v1:sha256:d209c0930a10e2dac0e6918cf466421e7935c9313d6a92d963b715040039c7d8:"
        }
      ]
    },
    {
      "id": "claim_62534f403078492aa865de44d1176465",
      "statement": "A thread's durable binding to its sandbox is the sandbox_id persisted in thread metadata; get_sandbox_id_from_metadata reads it (falling back to a live thread lookup) and fails open to no sandbox on error, letting any later run on any worker reconnect to the same box.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L365-L393",
          "version": "repo-lines-v1:sha256:a7cd6f6b2ed9979e24a8de27e005314e28c9a9cde6499b54ca9aea085657eff8:"
        }
      ]
    },
    {
      "id": "claim_21430c95060a4ae9abbf74019aeede0a",
      "statement": "SandboxBackendProxy is a stable per-thread handle whose target can be replaced; it subclasses BaseSandbox (not merely the protocol) so FilesystemMiddleware recognizes it as capture-at-source capable and keeps the in-sandbox stdout size cap on the execute offload path.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L53-L61",
          "version": "repo-lines-v1:sha256:26466a8c75330899dbb9ca6605cdb7d1e06cf7bdac2c139996a9023e5732deb0:"
        }
      ]
    },
    {
      "id": "claim_f33d48d63e1145929ce5799b993ffb5e",
      "statement": "SandboxBackendProxy is async-only: its synchronous methods raise NotImplementedError, while _aget_backend lazily reconnects (via a registered reconnect callback or by creating a sandbox from the metadata sandbox_id), serializes concurrent callers behind a lock, and caches the resolved backend back into SANDBOX_BACKENDS.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/state.py#L53-L186",
          "version": "repo-lines-v1:sha256:1a8828d50443a0ea5a3e3de25adeee48f0cbf3b633c39bacabd21f38aaa7a6bb:"
        }
      ]
    },
    {
      "id": "claim_419b5b3500cd4609a8c39850bfc9523a",
      "statement": "ensure_sandbox_for_thread is the get-or-create-then-reconnect entrypoint that guarantees a healthy sandbox bound to a thread; because dispatch uses multitask_strategy=interrupt a thread never provisions two sandboxes concurrently, so no cross-process sentinel is needed.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L268-L304",
          "version": "repo-lines-v1:sha256:404e915257dfd699bb3428de265cd49ca955acbd6df573eb9bd95a7f0e388519:"
        }
      ]
    },
    {
      "id": "claim_8bc4c3ca37dd4597a07ae4498d608ddd",
      "statement": "ensure_sandbox_for_thread handles three cases: reuse an in-memory cached backend, reconnect using the metadata sandbox_id, or create a new sandbox when neither exists.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L268-L389",
          "version": "repo-lines-v1:sha256:3ab2f3203af58c124d36ea7b665beca5fe5c040afa85d224b51ddca8bd71352c:"
        }
      ]
    },
    {
      "id": "claim_547d02c02f91489d8f3ef82a72b9bb7a",
      "statement": "For the cached and reconnect cases there is no separate reachability ping: _connect_existing_sandbox relies on the GitHub proxy refresh, which must reach the box anyway and raises SandboxUnreachableError when it cannot.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L229-L265",
          "version": "repo-lines-v1:sha256:11a46a21756d9d498b2cf400ed43104da37febd43259a5c1f74a9e969e9fcd9e:"
        }
      ]
    },
    {
      "id": "claim_e2bc4e74d24044cfbbb2de2df2f6ca85",
      "statement": "ensure_sandbox_for_thread persists the thread's sandbox_id into thread metadata only after the sandbox is created and initialized, and publishes the backend into SANDBOX_BACKENDS via set_sandbox_backend last, so a run that fails during initialization leaves no id to adopt and does not expose a half-initialized backend to the rest of the run.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L374-L388",
          "version": "repo-lines-v1:sha256:d2a6e2174762fd5259cd565c53763874427a9facd395c28695e6ba340366b3d8:"
        }
      ]
    },
    {
      "id": "claim_513c05d7958c42708dea97e02ba097cd",
      "statement": "SandboxGoneError signals a sandbox that no longer exists; because a deleted box holds no working tree and the stale metadata id is what every later run reconnects to, ensure_sandbox_for_thread always replaces it to avoid bricking the thread permanently.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L342-L372",
          "version": "repo-lines-v1:sha256:88ce9cf5c99c30b21651383f8b083b5b53ea359aac253575d96144949d89022d:"
        },
        {
          "resource": "repo://agent/sandboxes/providers/registry.py#L14-L19",
          "version": "repo-lines-v1:sha256:5714456962aa214e5aaa60d29b714556b1a49826250ff06b3130d50413bc723f:"
        }
      ]
    },
    {
      "id": "claim_f1c6007e99544682aecd264525eea1f7",
      "statement": "SandboxUnreachableError means the sandbox did not answer this run but may answer the next; it is never resolved by creating a replacement by default because the sandbox holds the agent's only copy of its working tree and an empty replacement would silently discard uncommitted work.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L342-L372",
          "version": "repo-lines-v1:sha256:88ce9cf5c99c30b21651383f8b083b5b53ea359aac253575d96144949d89022d:"
        },
        {
          "resource": "repo://agent/sandboxes/state.py#L32-L47",
          "version": "repo-lines-v1:sha256:036a975b6954afd9535858d390798ef265c98681531108069269065b746a1285:"
        }
      ]
    },
    {
      "id": "claim_121db4cece024a1d96ac69e50d5c9d70",
      "statement": "allow_replacement=True extends replacement to merely unreachable sandboxes and is used only by the reviewer, whose sandbox holds only a checkout it re-derives every run and whose per-PR threads outlive their sandboxes, so refusing to replace would brick reviews on that PR.",
      "evidence": [
        {
          "resource": "repo://agent/reviewer.py#L958-L962",
          "version": "repo-lines-v1:sha256:0c88e13fdc6144c26d8e9976e3a934970771d5b7c64783eb0d2801c70f6f5102:"
        },
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L293-L296",
          "version": "repo-lines-v1:sha256:d9dfc2ec9ac5bfa62380c189e2a024eb9fe06ea2e8c6afbcd8f38071d65acd2c:"
        }
      ]
    },
    {
      "id": "claim_833c6af65eb846099304fcfe31b6dd9a",
      "statement": "When replacing an unreachable or deleted sandbox itself fails, the error is re-raised as SandboxUnreachableError so callers still recognize the run has no sandbox and can notify the user.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L360-L371",
          "version": "repo-lines-v1:sha256:1f91ee8f8dd57289e32a64f77165091f0b5c4661e0cdd7e21d182a098de4f7e2:"
        }
      ]
    },
    {
      "id": "claim_b66c6bc2c5de42539374489b9533d6ec",
      "statement": "The LangSmith GitHub proxy injects credentials on the wire so no real GitHub token is written to disk in the sandbox: _github_proxy_rules sets an Authorization Basic header (base64 of x-access-token:token) for github.com and *.github.com and an Authorization Bearer header for api.github.com, plus a placeholder GH_TOKEN env var because gh refuses to run without a token in its environment.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/langsmith.py#L191-L219",
          "version": "repo-lines-v1:sha256:37449046e486bcd1a3644d657a4d5a057cb0a7fbd8d1b11e70feae5371f2643e:"
        }
      ]
    },
    {
      "id": "claim_d7f9c9872afa4d97889757f648750cfd",
      "statement": "The GitHub proxy token is minted at runtime from the GitHub App installation credentials via _resolve_proxy_token and is never stored as a deployment environment variable.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L48-L55",
          "version": "repo-lines-v1:sha256:5746bec20243bed95cf8b115bdb71cc7b7ca37b9eb0d4589e3ef3d8baf589813:"
        }
      ]
    },
    {
      "id": "claim_e71d0b27508240d5a9b8c9a76b723bfb",
      "statement": "Because the LangSmith proxy-config API rejects updates on a sandbox that is not ready, _configure_github_proxy responds to a not-ready status by best-effort starting the (stopped, not deleted) sandbox and retrying the PATCH, and retries transient failures with backoff.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/langsmith.py#L410-L454",
          "version": "repo-lines-v1:sha256:ee4c2a2476d80424824c790d0a6069f99d8d115685e92aac6adeedf083622f12:"
        }
      ]
    },
    {
      "id": "claim_8635ffdb6f2a40e4bd581a66175b6c13",
      "statement": "GitHub App installation tokens expire after about an hour, so agent/github/proxy.py records each thread's token expiry and scope and maybe_refresh_proxy_token re-mints and re-applies the token when within PROXY_TOKEN_REFRESH_WINDOW (5 minutes) of expiry or after PROXY_TOKEN_FALLBACK_TTL (50 minutes) when expiry is unknown, preserving the original repository and permission scope so rotation never broadens the token.",
      "evidence": [
        {
          "resource": "repo://agent/github/proxy.py#L1-L36",
          "version": "repo-lines-v1:sha256:8efed7e88f927aded43e2b05b78f03200258b46dd7631f6faba1578c26133ee1:"
        },
        {
          "resource": "repo://agent/github/proxy.py#L112-L189",
          "version": "repo-lines-v1:sha256:b981e59917773720b3db1d515554a92e539be475483ca8f5bcdeec2097c3ad35:"
        }
      ]
    },
    {
      "id": "claim_6f6ba49c285f4c98ba4006e64c95def3",
      "statement": "Every run re-applies the git identity (bot user.name/user.email) because reused or reconnected sandboxes can lose their --global config and Vercel preview deploys reject commits whose author email cannot be resolved to a GitHub account.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L195-L227",
          "version": "repo-lines-v1:sha256:f145f210059b920da4301f435687c71b8ef5954f78081d3a52ecd4344e7c3ac0:"
        }
      ]
    },
    {
      "id": "claim_f571969ec9d243ecb9abe4b5447bf4ce",
      "statement": "The git identity write is started in parallel with proxy configuration because it needs only the box (not the proxy), saving over a second of cold-start critical path before the first model call.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L202-L227",
          "version": "repo-lines-v1:sha256:0ee0cbbaf7f2e5876a489b6cb82870596f346069c9dcdc0fcc61f3040cf1cf0e:"
        }
      ]
    },
    {
      "id": "claim_ac87deb90bcd47d4a71673b324e97fcf",
      "statement": "The GitHub proxy applies only to the langsmith provider: _refresh_github_proxy and refresh_proxy_token return early when SANDBOX_TYPE is not langsmith.",
      "evidence": [
        {
          "resource": "repo://agent/github/proxy.py#L133-L133",
          "version": "repo-lines-v1:sha256:2cb5ac11ea608eecf710bcf430ceff95d6ceb129ae4ae57d3f7bbe811945715f:"
        },
        {
          "resource": "repo://agent/sandboxes/lifecycle.py#L144-L145",
          "version": "repo-lines-v1:sha256:2fe9b8e0dc1521741c02556ebeba7f81ad4f9864600f61ff86b9e2db72dc6f27:"
        }
      ]
    },
    {
      "id": "claim_0360f8d8a7e446aa92850cd110db81d7",
      "statement": "The local provider runs a LocalShellBackend directly on the host with no isolation, scoping git config --global to a sandbox-local .gitconfig-sandbox (that includes the developer's real ~/.gitconfig) so the per-run bot identity does not clobber the host identity, and excluding model/provider API keys from the inherited environment.",
      "evidence": [
        {
          "resource": "repo://agent/sandboxes/providers/local.py#L1-L64",
          "version": "repo-lines-v1:sha256:9e36148e840e91b630a80b841a3b875003c35962f3c0652248cd28f5f72611e6:"
        }
      ]
    },
    {
      "id": "claim_12e08831ea6c4f4e971623ad94dee745",
      "statement": "New sandboxes boot from the environment's ready snapshot when one exists, otherwise the admin-configured base snapshot (falling back to DEFAULT_SANDBOX_SNAPSHOT_ID), resolved by _resolve_sandbox_create_config alongside VM sizing and create parameters.",
      "evidence": [
