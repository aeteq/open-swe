    {
      "id": "claim_5f37c6f3fd0d4b7daf65acc42b1cb6c1",
      "statement": "The assembled agent middleware order (outer to inner) is PrepareAgentRunMiddleware, DynamicToolMiddleware (conditional), SanitizeToolInputsMiddleware, ModelCallLimitMiddleware, ToolErrorMiddleware, ExcludeToolsMiddleware, SubdirAgentsReadMiddleware, ToolRetryMiddleware, PullRequestCreationGuardMiddleware (non-local), WorkflowPushGuardMiddleware, refresh_github_proxy_before_model, check_message_queue_before_model (except stop-summary), TimeoutWrapupMiddleware, notify_step_limit_reached, record_run_usage, ModelFallbackMiddleware (conditional), PlanModeMiddleware, three message sanitizers, StableToolResultOrderMiddleware, ModelErrorMiddleware, and ModelCallTimeoutMiddleware.",
      "evidence": [
        {
          "resource": "repo://agent/server.py#L1297-L1351",
          "version": "repo-lines-v1:sha256:b5aed0f517f35647754b572ee5c4f79e380ee46dc8725beac017b2ca6a3d1199:"
        }
      ]
    },
