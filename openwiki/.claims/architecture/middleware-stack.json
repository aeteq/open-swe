    {
      "id": "claim_5f37c6f3fd0d4b7daf65acc42b1cb6c1",
      "statement": "The assembled agent middleware order (outer to inner) is ConversationOffloadingMiddleware, PrepareAgentRunMiddleware, IncidentMiddleware (conditional), WorkspaceSkillsMiddleware (conditional), DynamicToolMiddleware (conditional), SanitizeToolInputsMiddleware, ValidateImageReadsMiddleware, ModelCallLimitMiddleware, ToolErrorMiddleware, ExcludeToolsMiddleware, SubdirAgentsReadMiddleware, ToolRetryMiddleware, PullRequestCreationGuardMiddleware (non-local), WorkflowPushGuardMiddleware, refresh_github_proxy_before_model, check_message_queue_before_model (outside stop-summary mode), TimeoutWrapupMiddleware, notify_step_limit_reached, record_run_usage, ModelSelectionMiddleware (conditional), ModelFallbackMiddleware (conditional), PlanModeMiddleware, three message sanitizers, StableToolResultOrderMiddleware, ModelErrorMiddleware, and ModelCallTimeoutMiddleware.",
